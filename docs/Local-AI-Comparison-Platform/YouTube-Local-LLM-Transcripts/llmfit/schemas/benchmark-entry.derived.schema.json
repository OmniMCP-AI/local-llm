        "os": {
          "type": [
            "string",
            "null"
          ]
        },
        "vramGb": {
          "type": [
            "number",
            "null"
          ]
        },
        "unifiedMemoryGb": {
          "type": [
            "number",
            "null"
          ]
        },
        "ramGb": {
          "type": [
            "number",
            "null"
          ]
        },
        "gpuCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    }
  }
}
